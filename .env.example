# Backend (Express)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Admin credentials (backend only). Generate bcrypt hash via `node -e "import('bcryptjs').then(async b=>console.log(await b.hash(process.argv[1],12)))" 'your-secret'`
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash

# Public web origin used to generate email links (no trailing slash).
CLIENT_URL=https://fixlab-repair.vercel.app
CLIENT_ORIGINS=https://fixlab-repair.vercel.app

# Brevo transactional email API (server-side only; never commit your real .env file).
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=FixLab <your-verified-sender@example.com>
EMAIL_API_TIMEOUT_MS=15000

# Google Identity Services OAuth 2.0 popup sign-in (access-token flow; no client secret).
# Use the same Web application client ID in the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# For separate frontend/API sites use COOKIE_SAME_SITE=none and HTTPS in production.
# COOKIE_DOMAIN=.example.com
COOKIE_SAME_SITE=lax

# IPinfo geolocation API (server-side only; never expose this token to the frontend).
IPINFO_TOKEN=your_ipinfo_token
GEOLOCATION_API_TIMEOUT_MS=4000
GEOIP_CACHE_TTL_MS=21600000

# Render runs behind a reverse proxy; set this in Render Environment for the deployed service.
TRUSTED_PROXY=1

# Shared cache and distributed rate-limit store. Set REDIS_URL to a provisioned Redis instance.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=750
REDIS_DEFAULT_TTL=30
REDIS_CACHE_TTL_DEVICES=30
REDIS_CACHE_TTL_COLLECTIONS=60
REDIS_CACHE_TTL_SERVICES=15
REDIS_CACHE_TTL_PAYMENTS=15
REDIS_CACHE_TTL_ACTIVITIES=10

# Cloudinary image storage (server only; never expose to the browser)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=fixlab


# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@fixlab.example
