# Backend (Express)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://fixlab:xXGgUz3DyMclAcBJ@cluster0.y3l95ed.mongodb.net/
JWT_SECRET=replace-with-a-long-random-secret

# Admin credentials (backend only). Generate bcrypt hash via `node -e "import('bcryptjs').then(async b=>console.log(await b.hash(process.argv[1],12)))" 'your-secret'`
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash

# Public web origin used to generate email links (no trailing slash).
CLIENT_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000

# Gmail SMTP (server-only). EMAIL_PASS must be a Google App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=replace-with-google-app-password
EMAIL_FROM=FixLab <your-account@gmail.com>

# Generate with `npx web-push generate-vapid-keys`; keep the private key server-only.
# Production push notifications require HTTPS. Localhost is supported for development.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:security@fixlab.example

# Google Identity Services ID-token sign-in. The frontend uses this client ID.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Not used by the current Google Identity Services ID-token login flow.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# For separate frontend/API sites use COOKIE_SAME_SITE=none and HTTPS in production.
# COOKIE_DOMAIN=.example.com
COOKIE_SAME_SITE=lax

# Set only when Express is behind the listed trusted reverse proxy hops/IPs.
# TRUSTED_PROXY=1

# Shared cache and distributed rate-limit store. Set REDIS_URL to a provisioned Redis instance.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=750
REDIS_DEFAULT_TTL=30
REDIS_CACHE_TTL_DEVICES=30
REDIS_CACHE_TTL_COLLECTIONS=60
REDIS_CACHE_TTL_SERVICES=15
REDIS_CACHE_TTL_PAYMENTS=15
REDIS_CACHE_TTL_ACTIVITIES=10

# Cloudinary image storage (server only; never expose to the browser)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=fixlab

